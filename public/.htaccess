# web-whizz.com on cPanel (Apache). Copied into dist/ by the build.

# Unknown pages show the site's own 404 page.
ErrorDocument 404 /404.html

# /e/flow-downloader opens /e/flow-downloader/index.html
DirectoryIndex index.html

# Send everyone to https (the SSL certificate is set up by cPanel's AutoSSL).
RewriteEngine On
# www.web-whizz.com → web-whizz.com, so there's one address per page (for Google, and analytics only counts web-whizz.com).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Files in /assets/ have a unique name per build, so browsers may keep them for a year.
# Pages are always re-checked, so updates show up right away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
